{
  "name": "@jbelnick/planforge",
  "version": "0.1.0",
  "description": "Local-first control plane where Claude Code plans, a human approves, and Codex builds in verified Git worktrees.",
  "private": true,
  "license": "MIT",
  "author": "Jason Belnick",
  "homepage": "https://github.com/jbelnick/planforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbelnick/planforge.git"
  },
  "keywords": [
    "agent-orchestration",
    "ai-agents",
    "claude-code",
    "codex",
    "human-in-the-loop",
    "mcp"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite --host 127.0.0.1",
    "start": "tsx src/start-server.ts",
    "test": "vitest run",
    "test:json": "vitest run --reporter=json",
    "verify": "npm run build && npm test",
    "scan:public": "node scripts/public-safety-scan.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
